<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur für Demo-Benachrichtigungen; kein Internet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nur für den selbst gemalten Demo-Hintergrund der Store-Bilder. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/demo_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".DemoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Demo-Benachrichtigungen senden (per adb: am start -n <paket>/de.umstieg.launcher.demo.NotifyActivity). -->
        <activity
            android:name=".NotifyActivity"
            android:exported="true"
            android:label="@string/notify_title" />

        <!-- Demo-Hintergrund setzen (per adb: am start -n <paket>/de.umstieg.launcher.demo.WallpaperActivity). -->
        <activity
            android:name=".WallpaperActivity"
            android:exported="true"
            android:label="@string/wallpaper_title" />
    </application>
</manifest>
