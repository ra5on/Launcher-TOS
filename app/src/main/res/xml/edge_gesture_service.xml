<?xml version="1.0" encoding="utf-8"?>
<!--
  Bedienungshilfe „Systemweite Wischgesten“: nur schmale Streifen auf der Statusleiste und die Paketnamen
  der Fenster im Vordergrund (für „nur auf dem Homescreen“). Keine Fensterinhalte, keine Tastenereignisse,
  keine Gestensteuerung anderer Apps.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="200"
    android:description="@string/a11y_service_description"
    android:summary="@string/a11y_service_summary"
    android:isAccessibilityTool="false" />
